# ====================================================================
# SUMUT GO - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Salin file ini menjadi .env dan sesuaikan kredensial Anda.
# JANGAN PERNAH menyimpan kredensial asli / API key ke dalam Git.
# ====================================================================

# --------------------------------------------------------------------
# ENVIRONMENT
# --------------------------------------------------------------------
CI_ENVIRONMENT = development

# --------------------------------------------------------------------
# APP
# --------------------------------------------------------------------
app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false
app.CSPEnabled = false

# --------------------------------------------------------------------
# DATABASE (PostgreSQL 16 / Supabase Transaction Pooler)
# --------------------------------------------------------------------
database.default.hostname = aws-0-ap-south-1.pooler.supabase.com
database.default.database = postgres
database.default.username = postgres.YOUR_SUPABASE_PROJECT_REF
database.default.password = YOUR_SUPABASE_DB_PASSWORD
database.default.DBDriver = Postgre
database.default.port = 6543
database.default.schema = public
database.default.sslmode = require
database.default.pConnect = false
database.default.DBDebug = true
database.default.charset = utf8

# --------------------------------------------------------------------
# JWT AUTHENTICATION
# --------------------------------------------------------------------
JWT_SECRET = YOUR_RANDOM_64_CHAR_HEX_SECRET_KEY
JWT_TTL = 86400

# --------------------------------------------------------------------
# EXTERNAL TRANSPORT APPLICATION API
# --------------------------------------------------------------------
TRANSPORT_API_BASE_URL = https://transport-aplication.wrldapp.xyz
TRANSPORT_API_PUBLIC_KEY = YOUR_TRANSPORT_API_PUBLIC_KEY
TRANSPORT_API_SECRET_KEY = YOUR_TRANSPORT_API_SECRET_KEY
TRANSPORT_API_TIMEOUT = 12
