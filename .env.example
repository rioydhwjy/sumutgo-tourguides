# ====================================================================
# SUMUT GO - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Salin file ini menjadi .env dan sesuaikan kredensial database Anda.
# ====================================================================

# --------------------------------------------------------------------
# ENVIRONMENT
# --------------------------------------------------------------------
CI_ENVIRONMENT = development

# --------------------------------------------------------------------
# APP
# --------------------------------------------------------------------
app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false
app.CSPEnabled = false

# --------------------------------------------------------------------
# DATABASE (PostgreSQL 16 / Supabase Transaction Pooler)
# --------------------------------------------------------------------
database.default.hostname = aws-0-ap-south-1.pooler.supabase.com
database.default.database = postgres
database.default.username = postgres.xffqsryvsdmfxnxwspjx
database.default.password = YOUR_SUPABASE_PASSWORD_HERE
database.default.DBDriver = Postgre
database.default.port = 6543
database.default.schema = public
database.default.sslmode = require
database.default.pConnect = false
database.default.DBDebug = true
database.default.charset = utf8
