    {
      "name": "03. Tour Guides",
      "item": [
        {
          "name": "List Pemandu Wisata (Filter, Sort & Pagination)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/guides?page=1&per_page=15&status=Tersedia&sort=rating_desc",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "guides"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "15" },
                { "key": "status", "value": "Tersedia" },
                { "key": "sort", "value": "rating_desc" }
